rules_version = '2';
// Firestore security rules for CR Home Pros (project crhomepros-9309c).
// Deploy: firebase deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // The one admin account, signed in with Google (same as lib/firebase-auth.ts)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'crhomepros@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Public website content: anyone can read, only admin can change
    match /banners/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /site_settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{id}      { allow read: if true; allow write: if isAdmin(); }

    // Reviews: visitors can submit (unapproved) and read approved ones
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.approved == false
                    && request.resource.data.keys().hasAll(['name', 'rating']);
      allow update, delete: if isAdmin();
    }

    // Private business data: admin only. Website forms write these through
    // the server (Admin SDK), which bypasses these rules.
    match /leads/{id}           { allow read, write: if isAdmin(); }
    match /contacts/{id}        { allow read, write: if isAdmin(); }
    match /referrals/{id}       { allow read, write: if isAdmin(); }
    match /field_notes/{id}     { allow read, write: if isAdmin(); }
    match /admin_documents/{id} { allow read, write: if isAdmin(); }  // invoices, contracts, change orders

    // Everything else: closed
    match /{document=**} { allow read, write: if false; }
  }
}
